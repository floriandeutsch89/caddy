# Global options and shared snippets. Sites live in sites/*.caddy, one file per
# site; every site block gets its own certificate automatically.
{
	email {$ACME_EMAIL}

	# Asks CrowdSec (compose.yaml) per request whether the client IP is banned,
	# then lets its AppSec WAF check the request itself.
	# Rate limit before AppSec: floods are rejected cheaply, not sent to the WAF.
	order crowdsec first
	order rate_limit after crowdsec
	order appsec after rate_limit
	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_API_KEY}
		appsec_url http://crowdsec:7422
		# Sites stay up if AppSec is down (the IP check still applies).
		appsec_fail_open
		# Only the first 1 MiB of a body is inspected and buffered in memory.
		appsec_max_body_bytes 1048576
	}
}

# Shared per-site defaults: `import common` in each site.
(common) {
	encode zstd gzip
	header {
		# No includeSubDomains here: it would force HTTPS on subdomains hosted
		# elsewhere for a year. Add it per site where all subdomains are HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	crowdsec
	appsec
	# JSON access log on a shared volume; CrowdSec detects attacks from it.
	# Short retention: CrowdSec reads it live, nothing else needs it.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 2
			roll_keep_for 48h
		}
		format json
	}
	# Static assets are not counted; pages and API calls are.
	@limited not path *.css *.js *.mjs *.map *.png *.jpg *.jpeg *.gif *.svg *.webp *.avif *.ico *.woff *.woff2
	rate_limit @limited {
		zone per_ip {
			key {remote_host}
			events 1000
			window 1m
		}
	}
}

import sites/*.caddy
