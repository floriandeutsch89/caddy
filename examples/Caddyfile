# Global options and shared snippets. Sites live in sites/*.caddy, one file per
# site; every site block gets its own certificate automatically.
{
	email {$ACME_EMAIL}
	order rate_limit before reverse_proxy

	# CrowdSec bouncer: needs a CrowdSec LAPI and a bouncer key (README).
	# order crowdsec first
	# crowdsec {
	# 	api_url http://crowdsec:8080
	# 	api_key {$CROWDSEC_API_KEY}
	# }
}

# Shared per-site defaults: `import common` in each site.
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# crowdsec
	rate_limit {
		zone per_ip {
			key {remote_host}
			events 300
			window 1m
		}
	}
}

import sites/*.caddy
