# Smoke-test config: uses every plugin so `caddy validate` fails if one is
# missing or its Caddyfile syntax breaks. Never served.
{
	order crowdsec first
	order rate_limit after crowdsec
	order appsec after rate_limit
	crowdsec {
		api_url http://crowdsec:8080
		api_key dummy
		appsec_url http://crowdsec:7422
		appsec_fail_open
		appsec_max_body_bytes 1048576
	}
	acme_dns acmedns {
		username dummy
		password dummy
		subdomain dummy
		server_url https://auth.example.com
	}
}

example.com {
	crowdsec
	appsec
	rate_limit {
		zone per_ip {
			key {remote_host}
			events 100
			window 1m
		}
	}
	respond "ok"
}
